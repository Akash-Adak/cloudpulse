# Copy to .env and replace every placeholder. NEVER commit .env.

# --- Application ---
SERVER_PORT=8080
SERVER_SHUTDOWN=graceful

# --- Database ---
# Use DB_URL for a complete JDBC URL, or configure the individual fields.
DB_URL=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cloudpulse
DB_USER=cloudpulse
DB_PASSWORD=change-me-db-password
# Used by docker-compose when running the bundled MySQL service.
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=cloudpulse
MYSQL_USER=cloudpulse
MYSQL_PASSWORD=change-me-db-password

# --- Dashboard administrator ---
CLOUDPULSE_ADMIN_USERNAME=admin
# At least 10 characters; required by the backend.
CLOUDPULSE_ADMIN_PASSWORD=change-me-admin-password
# At least 32 characters; generate with: openssl rand -base64 48
CLOUDPULSE_JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
CLOUDPULSE_JWT_TTL_MINUTES=480

# --- Networking ---
FRONTEND_PORT=8080
CLOUDPULSE_CORS_ALLOWED_ORIGINS=http://localhost:5173
# LOCAL TESTING ONLY. Allows localhost/private targets. Keep false anywhere reachable from the internet.
CLOUDPULSE_ALLOW_PRIVATE_TARGETS=false

# --- Monitoring ---
CLOUDPULSE_PROBE_MAX_REDIRECTS=3
CLOUDPULSE_SCHEDULER_ENABLED=true
CLOUDPULSE_SCHEDULER_TICK_MS=5000
CLOUDPULSE_SCHEDULER_INITIAL_DELAY_MS=5000
CLOUDPULSE_RECOVERY_THRESHOLD=1
CLOUDPULSE_RETENTION_DAYS=30
CLOUDPULSE_RETENTION_CRON="0 30 3 * * *"

# --- Optional e-mail alerts (any SMTP server, e.g. AWS SES SMTP or a Gmail app password) ---
CLOUDPULSE_ALERTS_ENABLED=false
CLOUDPULSE_ALERT_RECIPIENTS=
CLOUDPULSE_ALERT_FROM=cloudpulse@localhost
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# --- Production deployment ---
AWS_REGION=ap-south-1
API_DOMAIN=api.your-domain.example
